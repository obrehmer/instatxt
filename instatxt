#!/usr/bin/env python3

from openai import OpenAI
import os
import sys

api_key = os.getenv("OPENAI_API_KEY")
if not api_key:
    print("OPENAI_API_KEY is not set.", file=sys.stderr)
    sys.exit(1)

client = OpenAI(api_key=api_key)

# Kameraauswahl mit Default (1)
print("Choose Camera:")
print("1: Canon EOS 10 (35-135 mm Zoom)")
print("2: Canon AF35ML (Canon Lens 40 mm)")
cam_choice = input("Select camera [1]: ") or "1"

if cam_choice == "2":
    cam = "Canon AF35ML"
    obj = "Canon Lens 40 mm"
else:
    cam = "Canon EOS 10"
    obj = "35-135 mm Zoom"

# Weitere Eingaben
loc = input("Location: ")
year = input("Year (2026): ") or "2026"
month = input("Month: ")
add = input("Additions: ")
fixtags = "#film #kleinbild #35mm #analog #filmphotography"

ai_system_message = (
    "Write an Instagram caption in English for an analog photo. "
    "Use simple language and a neutral, professional tone. "
    "Write one compact paragraph with three to five natural sentences. "
    "Start with the location and the month/year the picture was taken. "
    "Mention the camera model and lens near the end. "
    "Avoid the word 'my'; use 'a', 'the', or another natural alternative. "
    "Keep the caption around 700 to 1000 characters including hashtags. "
    "Include the fixed hashtags from the user and add enough relevant hashtags to reach about 20 total. "
    "Avoid contrast sentence structures like 'not X but Y'. "
    "Avoid dramatic three-part sequences or staged escalation patterns. "
    "Do not use epic framing phrases such as 'at the end of the day', 'that is the point', or similar. "
    "Do not structure the text with many short lines or excessive spacing; keep it as normal flowing sentences. "
    "Avoid rhetorical questions entirely. "
    "Do not use emojis. "
    "Avoid using dashes, especially long dashes, to create tension or emphasis; use standard punctuation instead."
)
ai_user_message = (
    f"taken with {cam} with a lens {obj}, in {loc}, in the {month} of {year}, {add}, add the hashtags {fixtags}"
)

completion = client.chat.completions.create(
    model=os.getenv("OPENAI_MODEL", "gpt-4o-mini"),
    messages=[
        {"role": "system", "content": ai_system_message},
        {"role": "user", "content": ai_user_message}
    ]
)

answer = completion.choices[0].message.content

print(str(answer).strip())
